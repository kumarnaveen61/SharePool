# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sharepool"

# Secret used to sign session/auth JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

NODE_ENV="production"

# Reserved for later phases — leave blank until configured.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS=""
AI_PROVIDER_API_KEY=""
STORAGE_PROVIDER_URL=""
STORAGE_PROVIDER_KEY=""
APPLICATION_URL="https://your-domain.example.com"
