<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11141A"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/splashRings"
        android:layout_width="160dp"
        android:layout_height="130dp"
        android:src="@drawable/splash_rings_animated"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/splashWordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="SharePool"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="-0.01"
        android:alpha="0"
        android:scaleX="0.2"
        android:scaleY="0.2" />

    <TextView
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Share smart. Save together."
        android:textColor="#B3A489"
        android:textSize="13sp"
        android:letterSpacing="0.04"
        android:alpha="0" />

</LinearLayout>