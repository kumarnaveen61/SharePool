<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_rings">

    <target android:name="ring1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateY" android:valueType="floatType" android:valueFrom="-22" android:valueTo="0" android:duration="1700" android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="scaleX" android:valueType="floatType" android:valueFrom="0.65" android:valueTo="1" android:duration="1700" android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="scaleY" android:valueType="floatType" android:valueFrom="0.65" android:valueTo="1" android:duration="1700" android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="ring2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:valueType="floatType" android:valueFrom="-24" android:valueTo="0" android:duration="1700" android:startOffset="250" android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="translateY" android:valueType="floatType" android:valueFrom="18" android:valueTo="0" android:duration="1700" android:startOffset="250" android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="scaleX" android:valueType="floatType" android:valueFrom="0.65" android:valueTo="1" android:duration="1700" android:startOffset="250" android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="scaleY" android:valueType="floatType" android:valueFrom="0.65" android:valueTo="1" android:duration="1700" android:startOffset="250" android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="ring3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:valueType="floatType" android:valueFrom="24" android:valueTo="0" android:duration="1700" android:startOffset="250" android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="translateY" android:valueType="floatType" android:valueFrom="18" android:valueTo="0" android:duration="1700" android:startOffset="250" android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="scaleX" android:valueType="floatType" android:valueFrom="0.65" android:valueTo="1" android:duration="1700" android:startOffset="250" android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="scaleY" android:valueType="floatType" android:valueFrom="0.65" android:valueTo="1" android:duration="1700" android:startOffset="250" android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>