<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_rings">

    <!-- Ring 1 (top) — moves down to center, then back up -->
    <target android:name="ring1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="8"
                    android:duration="500"
                    android:interpolator="@android:interpolator/accelerate_decelerate"
                    android:repeatMode="reverse"
                    android:repeatCount="1" />
            </set>
        </aapt:attr>
    </target>

    <!-- Ring 2 (bottom-left) — moves up-right to center, then back -->
    <target android:name="ring2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="translateX"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="6.5"
                    android:duration="500"
                    android:interpolator="@android:interpolator/accelerate_decelerate"
                    android:repeatMode="reverse"
                    android:repeatCount="1" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="-4"
                    android:duration="500"
                    android:interpolator="@android:interpolator/accelerate_decelerate"
                    android:repeatMode="reverse"
                    android:repeatCount="1" />
            </set>
        </aapt:attr>
    </target>

    <!-- Ring 3 (bottom-right) — moves up-left to center, then back -->
    <target android:name="ring3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="translateX"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="-6.5"
                    android:duration="500"
                    android:interpolator="@android:interpolator/accelerate_decelerate"
                    android:repeatMode="reverse"
                    android:repeatCount="1" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="-4"
                    android:duration="500"
                    android:interpolator="@android:interpolator/accelerate_decelerate"
                    android:repeatMode="reverse"
                    android:repeatCount="1" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>